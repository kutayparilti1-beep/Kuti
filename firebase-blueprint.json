{
  "entities": {
    "UserRegistryEntry": {
      "title": "UserRegistryEntry",
      "description": "Minimal authenticated user registry entry for admin visibility.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastSeenAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt", "lastSeenAt"]
    },
    "KnownFace": {
      "title": "KnownFace",
      "description": "Learned facial visual signature and identity notes introduced by the user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "relation": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "visualSignature": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1500
        },
        "facialTraits": {
          "type": "array",
          "description": "Up to 12 concise visual traits for matching."
        },
        "learnedNotes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        },
        "recognitionCount": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "name",
        "relation",
        "visualSignature",
        "facialTraits",
        "learnedNotes",
        "recognitionCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "LearnedMemory": {
      "title": "LearnedMemory",
      "description": "Adaptive memory item taught to the voice assistant.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "category": {
          "type": "string",
          "enum": ["preference", "person_fact", "routine", "instruction", "workspace_note"]
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "source": {
          "type": "string",
          "enum": ["voice", "vision", "workspace"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerId", "category", "subject", "content", "source", "createdAt", "updatedAt"]
    },
    "AssistantTask": {
      "title": "AssistantTask",
      "description": "Actionable task or deep reasoning briefing generated by the assistant.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "category": {
          "type": "string",
          "enum": ["briefing", "email", "calendar", "drive", "analysis"]
        },
        "status": {
          "type": "string",
          "enum": ["pending", "completed"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerId", "title", "summary", "category", "status", "createdAt", "updatedAt"]
    },
    "UserNotification": {
      "title": "UserNotification",
      "description": "Notification log triggered by voice reminders or Workspace alerts.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "source": {
          "type": "string",
          "enum": ["voice", "gmail", "calendar", "system"]
        },
        "read": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerId", "title", "body", "source", "read", "createdAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Persistent multi-turn Gemini chatbot message.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["user", "model"]
        },
        "botRole": {
          "type": "string",
          "enum": ["general", "deep_reasoning", "architect", "fast"]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerId", "role", "botRole", "text", "createdAt"]
    }
  },
  "firestore": {
    "/user_registry/{userId}": {
      "schema": { "$ref": "#/entities/UserRegistryEntry" },
      "description": "Email registry visible exclusively to verified admin kutayparilti1@gmail.com."
    },
    "/users/{userId}/known_faces/{faceId}": {
      "schema": { "$ref": "#/entities/KnownFace" },
      "description": "User-private learned face profiles for visual identification."
    },
    "/users/{userId}/memories/{memoryId}": {
      "schema": { "$ref": "#/entities/LearnedMemory" },
      "description": "User-private learned facts, routines, and preferences."
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/AssistantTask" },
      "description": "User-private tasks and deep reasoning analyses."
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/UserNotification" },
      "description": "User-private notification history."
    },
    "/users/{userId}/chat_messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "User-private multi-turn Gemini chatbot conversation history."
    }
  }
}
